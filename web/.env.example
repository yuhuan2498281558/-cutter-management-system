# Shared frontend defaults. Copy to .env.local for a local override.
VITE_API_URL=/api/
VITE_BACKEND_PORT=8000
VITE_PORT=5173
VITE_OPEN=false
VITE_PUBLIC_PATH=/
VITE_PM_ENABLED=true

# Optional AMap configuration. Leave empty when maps are not used.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Optional engineering drawings. They are not part of the public repository;
# place the files under web/public/ and set their paths. Empty values fall back
# to /cutterhead-placeholder.svg (cutterhead) or no image (login background).
VITE_CUTTERHEAD_IMAGE=
VITE_CUTTERHEAD_CLEAN_IMAGE=
VITE_LOGIN_BACKGROUND_IMAGE=
