# AI assistant LLM provider examples.
# Copy needed values into your local environment. Do not commit real API keys.

# Default local Ollama mode
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=qwen2.5:7b
AI_LLM_BASE_URL=http://localhost:11434

# DeepSeek OpenAI-compatible API mode
# AI_LLM_PROVIDER=deepseek
# AI_LLM_MODEL=deepseek-chat
# AI_LLM_API_KEY=sk-your-deepseek-key

# Reasoning model benchmark
# AI_LLM_PROVIDER=deepseek
# AI_LLM_MODEL=deepseek-reasoner
# AI_LLM_API_KEY=sk-your-deepseek-key

# Assistant routing mode:
# hybrid = rule routing + deterministic tools + LLM fallback
# agent = pure Agent tool selection, for paper comparison
AI_ASSISTANT_ROUTE_MODE=hybrid

# Optional generation controls
AI_LLM_TEMPERATURE=0.1
AI_LLM_TIMEOUT=60
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024

# Memory rollout: keep legacy until the Django tables are migrated and
# dual-write parity has been checked, then switch to django.
AI_MEMORY_BACKEND=legacy
AI_MEMORY_DUAL_WRITE=0
AI_MEMORY_CONTEXT_TOKEN_BUDGET=1200
AI_MEMORY_SUMMARY_TOKEN_BUDGET=400
AI_MEMORY_RECENT_TURNS=3
AI_MEMORY_SUMMARY_TRIGGER_TOKENS=1800
