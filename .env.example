POSTGRES_DB=daoju
POSTGRES_USER=daoju_user
POSTGRES_PASSWORD=replace-with-a-local-password

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

REDIS_PASSWORD=

# Django signing key. Generate a unique value for every deployment.
DJANGO_SECRET_KEY=replace-with-a-random-secret

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
RUN_MIGRATIONS_ON_START=0
RUN_INIT_ON_START=0

# Optional AI assistant settings.
AI_LLM_PROVIDER=deepseek
AI_LLM_MODEL=deepseek-chat
AI_LLM_BASE_URL=https://api.deepseek.com/v1
AI_LLM_API_KEY=

# Optional BIMFace integration. Leave empty to disable the integration.
BIMFACE_APP_KEY=
BIMFACE_APP_SECRET=
BIMFACE_FILE_ID=
